<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_top">

    <!-- Login Screen Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- FoodAI Logo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥗"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="FoodAI"
                android:textColor="@color/green_dark"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:text="Your Smart Food and Nutrition Assistant"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Login Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back!"
                    android:textColor="@color/green_dark"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="Login to continue your healthy journey."
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />

                <!-- Full Name -->
                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/green_check"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_grey"
                    android:visibility="gone" />

                <!-- Email -->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/green_check"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_grey" />

                <!-- Password -->
                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:backgroundTint="@color/green_check"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_grey" />

                <!-- Login / Sign Up Button -->
                <Button
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="@color/green_dark"
                    android:text="Login"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <!-- Switch Login / Sign Up -->
                <TextView
                    android:id="@+id/switchModeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Don't have an account? Sign Up"
                    android:textColor="@color/green_dark"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Eat Smart. Live Healthy. 💚"
                android:textColor="@color/green_dark"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Top Right Leaf -->
    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="5dp"
        android:alpha="0.3"
        android:rotation="25"
        android:src="@drawable/ic_leaf"
        android:contentDescription="Decorative leaf"
        android:clickable="false"
        android:focusable="false" />

    <!-- Bottom Left Leaf -->
    <ImageView
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="15dp"
        android:alpha="0.6"
        android:rotation="-20"
        android:src="@drawable/ic_leaf"
        android:contentDescription="Decorative leaf"
        android:clickable="false"
        android:focusable="false"
        app:tint="@color/green_check" />

</FrameLayout>
